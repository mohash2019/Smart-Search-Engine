# Web search provider: brave or bing
SEARCH_PROVIDER=brave

# Secret key for the selected web search provider
SEARCH_API_KEY=PUT_YOUR_SEARCH_API_KEY_HERE

# Optional custom endpoint
# SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# Optional: enables direct YouTube aggregation from the backend
YOUTUBE_API_KEY=PUT_YOUR_YOUTUBE_API_KEY_HERE

# Maximum number of results requested per provider
MAX_RESULTS=50
